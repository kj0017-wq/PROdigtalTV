rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function roleMatches(storedRole, role) {
      return storedRole == role
        || (role == "admin" && (storedRole == "Admin" || storedRole == "administrator" || storedRole == "owner"))
        || (role == "editor" && (storedRole == "Editor" || storedRole == "redakteur" || storedRole == "redaktion"))
        || (role == "member" && (storedRole == "Mitglied" || storedRole == "mitglied"));
    }
    function roleIs(role) {
      return signedIn() && (
        (
          profileExists()
          && roleMatches(profile().role, role)
          && profile().status != "inactive"
        )
        || roleMatches(request.auth.token.role, role)
      );
    }
    function member() {
      return editor() || (roleIs("member") && activeLinkedMember());
    }
    function memberAccessBlocked(memberData) {
      return (memberData.membershipAccessStatus == "inactive" || memberData.membershipAccessStatus == "cancelled")
        && (
          !memberData.keys().hasAny(["membershipAccessEffectiveAt"])
          || memberData.membershipAccessEffectiveAt <= request.time
        );
    }
    function publicMemberRecord(memberData) {
      return memberData.visible == true
        && memberData.isLive == true
        && memberData.status == "active"
        && memberData.visibility == "public";
    }
    function memberRecordActive(memberId) {
      return exists(/databases/$(database)/documents/members/$(memberId))
        && get(/databases/$(database)/documents/members/$(memberId)).data.status == "active"
        && !memberAccessBlocked(get(/databases/$(database)/documents/members/$(memberId)).data);
    }
    function activeLinkedMember() {
      return profileExists()
        && profile().status != "inactive"
        && profile().memberId is string
        && profile().memberId != ""
        && memberRecordActive(profile().memberId);
    }
    function ownMember(memberId) {
      return signedIn()
        && profileExists()
        && profile().status != "inactive"
        && profile().memberId == memberId
        && memberRecordActive(memberId);
    }
    function memberProfileUpdateFields() {
      return [
        "id",
        "name",
        "description",
        "website",
        "category",
        "street",
        "postalCode",
        "city",
        "country",
        "contactEmail",
        "email",
        "phone",
        "contactPhone",
        "mobile",
        "contactMobile",
        "profileContactName",
        "contactName",
        "eventContacts",
        "personalSalutation",
        "profileUpdatedAt",
        "profileUpdatedBy",
        "updatedAt"
      ];
    }
    function editor() {
      return roleIs("editor") || admin();
    }
    function admin() {
      return roleIs("admin");
    }
    function publicPublished() {
      return (resource.data.status == "published" || resource.data.status == "aktiv")
        && (resource.data.visibility == "public" || resource.data.sichtbarkeit == "oeffentlich");
    }
    function publicMemberEventTeaser() {
      return resource.data.accessType == "members_only"
        && (
          resource.data.status == "active"
          || resource.data.status == "published"
          || resource.data.status == "aktiv"
        );
    }
    function registrationEvent() {
      return get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data;
    }
    function allowedRegistrationTarget() {
      return (
          registrationEvent().registrationEnabled == true
          || registrationEvent().preStatus == "invitation_published"
          || registrationEvent().lifecyclePhase == "registration_open"
        )
        && (
          (
            registrationEvent().accessType == "public"
            && (
              registrationEvent().registrationEnabled == true
              || registrationEvent().preStatus == "invitation_published"
              || registrationEvent().lifecyclePhase == "registration_open"
              || registrationEvent().allowPublicRegistration == true
              || !registrationEvent().keys().hasAny(["allowPublicRegistration"])
            )
          )
          || (member() && registrationEvent().accessType == "members_only" && registrationEvent().allowMemberRegistration == true)
        );
    }

    match /events/{eventId} {
      allow read: if publicPublished()
        || publicMemberEventTeaser()
        || (member() && resource.data.accessType == "members_only")
        || editor();
      allow create, update, delete: if editor();
    }

    match /topics/{id} {
      allow read: if resource.data.status == "active" || editor();
      allow write: if editor();
    }

    match /editorialContent/{id} {
      allow read: if publicPublished()
        || (member() && (
          resource.data.visibility == "members"
          || resource.data.section == "member-area"
          || resource.data.page == "member-area"
        ))
        || editor();
      allow write: if editor();
    }

    match /members/{id} {
      allow read: if publicMemberRecord(resource.data)
        || editor()
        || ownMember(id);
      allow create, delete: if editor();
      allow update: if editor()
        || (
          ownMember(id)
          && request.resource.data.id == id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(memberProfileUpdateFields())
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["profileUpdatedBy"])
            || request.resource.data.profileUpdatedBy == request.auth.uid
            || request.resource.data.profileUpdatedBy == request.auth.token.email
          )
        );
    }

    match /contacts/{id} {
      allow read, write: if editor();
    }

    match /boardMembers/{id} {
      allow read: if resource.data.visibility == "public" && resource.data.status == "active" || editor();
      allow write: if editor();
    }

    match /speakers/{id} {
      allow read: if resource.data.status == "published" || editor();
      allow write: if editor();
    }

    match /sponsors/{id} {
      allow read: if resource.data.status == "published" || editor();
      allow write: if editor();
    }

    match /eventMedia/{id} {
      allow read: if resource.data.visibility == "public" && resource.data.status == "approved"
        || (member() && resource.data.visibility == "members" && resource.data.status == "approved")
        || editor();
      allow write: if editor();
    }

    match /media/{id} {
      allow read, write: if editor();
    }

    match /media_assets/{id} {
      allow read: if editor()
        || (resource.data.visibility == "public" && resource.data.status == "active");
      allow write: if editor();
    }

    match /media_variants/{id} {
      allow read, write: if editor();
    }

    match /media_videos/{id} {
      allow read, write: if editor();
    }

    match /downloads/{id} {
      allow read: if publicPublished()
        || (member() && resource.data.visibility == "members")
        || editor();
      allow write: if editor();
    }

    match /memberDocuments/{id} {
      allow read: if (member() && resource.data.visibility == "members" && resource.data.status == "published")
        || editor();
      allow write: if editor();
    }

    match /memberDirectories/{id} {
      allow read: if (member() && resource.data.visibility == "members" && resource.data.status == "active")
        || editor();
      allow write: if editor();
    }

    match /galleries/{id} {
      allow read: if publicPublished()
        || (member() && resource.data.visibility == "members")
        || editor();
      allow write: if editor();
    }

    match /galleryImages/{id} {
      allow read: if resource.data.visibility == "public" && resource.data.status == "approved"
        || (member() && resource.data.visibility == "members" && resource.data.status == "approved")
        || editor();
      allow write: if editor();
    }

    match /registrations/{id} {
      // The client can initiate a public registration but cannot create tokens or set confirmation.
      allow create: if request.resource.data.status == "pending_email_confirmation"
        && request.resource.data.emailConfirmed == false
        && request.resource.data.privacyAccepted == true
        && allowedRegistrationTarget()
        && !request.resource.data.keys().hasAny(["confirmationTokenHash", "confirmedAt", "internalNote"]);
      allow read: if editor() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if editor();
    }

    match /checkinScreenEvents/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /membershipApplications/{id} {
      allow create: if request.resource.data.status == "new"
        && request.resource.data.source == "website"
        && request.resource.data.privacyAccepted == true
        && request.resource.data.statutesAccepted == true
        && request.resource.data.feeInfoAccepted == true
        && request.resource.data.company is string
        && request.resource.data.email is string
        && !request.resource.data.keys().hasAny(["internalNote", "reviewedAt", "reviewedBy"]);
      allow read, update, delete: if editor();
    }

    match /mailQueue/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /aiLogs/{id} {
      allow read: if editor();
      allow create: if editor();
      allow update, delete: if false;
    }

    match /aiDrafts/{id} {
      allow read: if editor() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if editor();
      allow delete: if admin();
    }

    match /verified_sources/{id} {
      allow read, write: if editor();
    }

    match /article_sources/{id} {
      allow read, write: if editor();
    }

    match /article_keywords/{id} {
      allow read, write: if editor();
    }

    match /ai_prompts/{id} {
      allow read, write: if editor();
    }

    match /ai_image_generations/{id} {
      allow read: if editor();
      allow create: if editor();
      allow update, delete: if false;
    }

    match /ai_prompt_versions/{id} {
      allow read, write: if editor();
    }

    match /ai_prompt_tests/{id} {
      allow read, write: if editor();
    }

    match /ai_editorial_logs/{id} {
      allow read: if editor();
      allow create: if editor();
      allow update, delete: if false;
    }

    match /ai_topic_suggestions/{id} {
      allow read, write: if editor();
    }

    match /ai_topic_queue/{id} {
      allow read, write: if editor();
    }

    match /ai_topic_raw_data/{id} {
      allow read, write: if editor();
    }

    match /ai_press_releases/{id} {
      allow read, write: if editor();
    }

    match /ai_press_import_runs/{id} {
      allow read, write: if editor();
    }

    match /ai_press_source_status/{id} {
      allow read, write: if editor();
    }

    match /users/{userId} {
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow write: if admin();
    }

    match /settings/{id} {
      allow read: if editor() || id == "browserPush";
      allow write: if admin() || (editor() && (id == "eventTypes" || id == "browserPush"));
    }

    match /system/{id} {
      allow read, write: if admin();
    }

    match /auditLog/{id} {
      allow read: if admin();
      allow create: if editor();
      allow update, delete: if false;
    }
  }
}
