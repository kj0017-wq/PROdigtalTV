rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function accountingYearOpen(year) {
      return !year.matches('^[0-9]{4}$') || !exists(/databases/$(database)/documents/accountingYearClosures/$(year));
    }
    function accountingRecordOpen(data) {
      let year = string(data.get('accountingPeriodYear', data.get('year', string(data.get('invoiceDate', data.get('date', data.get('periodFrom', ''))))[0:4])));
      let paid = string(data.get('paidDate', ''));
      let end = string(data.get('periodTo', ''));
      return accountingYearOpen(year)
        && (paid.size() < 4 || accountingYearOpen(paid[0:4]))
        && (end.size() < 4 || accountingYearOpen(end[0:4]));
    }
    function accountingClaimOpen(collection, key, invoices) {
      let path = /databases/$(database)/documents/$(collection)/$(key);
      return !exists(path) || accountingRecordOpen(get(/databases/$(database)/documents/$(invoices)/$(get(path).data.invoiceId)).data);
    }
    function accountingAssignmentOpen() {
      let key = request.resource.data.bookingKey;
      let parts = key.split(':');
      let old = resource == null ? {} : resource.data.get('assignments', {});
      let claimKey = parts[0] + '_' + parts[1];
      return parts.size() == 2
        && request.resource.data.assignments.diff(old).affectedKeys().hasOnly([key])
        && accountingRecordOpen(get(/databases/$(database)/documents/accountingStatements/$(parts[0])).data)
        && accountingClaimOpen('accountingPaymentMatches', claimKey, 'accountingIncomingInvoices')
        && accountingClaimOpen('accountingOutgoingPaymentMatches', claimKey, 'membershipContributions');
    }
    match /accountingYearSecurity/{id} {
      allow read, write: if false;
    }
    match /accountingYearClosureHistory/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /accountingYearClosures/{year} {
      allow read: if admin();
      allow write: if false;
    }
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function roleMatches(storedRole, role) {
      return storedRole == role
        || (role == "admin" && (storedRole == "Admin" || storedRole == "administrator" || storedRole == "owner"))
        || (role == "editor" && (storedRole == "Editor" || storedRole == "redakteur" || storedRole == "redaktion"))
        || (role == "member" && (storedRole == "Mitglied" || storedRole == "mitglied"));
    }
    function roleIs(role) {
      return signedIn() && (
        (
          profileExists()
          && roleMatches(profile().role, role)
          && profile().status != "inactive"
        )
        || roleMatches(request.auth.token.role, role)
      );
    }
    function member() {
      return editor() || (roleIs("member") && activeLinkedMember());
    }
    function memberAccessBlocked(memberData) {
      return (memberData.membershipAccessStatus == "inactive" || memberData.membershipAccessStatus == "cancelled")
        && (
          !memberData.keys().hasAny(["membershipAccessEffectiveAt"])
          || memberData.membershipAccessEffectiveAt <= request.time
        );
    }
    function publicMemberRecord(memberData) {
      return memberData.visible == true
        && memberData.isLive == true
        && memberData.status == "active"
        && memberData.visibility == "public";
    }
    function memberRecordActive(memberId) {
      return exists(/databases/$(database)/documents/members/$(memberId))
        && get(/databases/$(database)/documents/members/$(memberId)).data.status == "active"
        && !memberAccessBlocked(get(/databases/$(database)/documents/members/$(memberId)).data);
    }
    function activeLinkedMember() {
      return profileExists()
        && profile().status != "inactive"
        && profile().memberId is string
        && profile().memberId != ""
        && memberRecordActive(profile().memberId);
    }
    function ownMember(memberId) {
      return signedIn()
        && profileExists()
        && profile().status != "inactive"
        && profile().memberId == memberId
        && memberRecordActive(memberId);
    }
    function memberProfileUpdateFields() {
      return [
        "id",
        "name",
        "description",
        "website",
        "category",
        "street",
        "postalCode",
        "city",
        "country",
        "contactEmail",
        "email",
        "phone",
        "contactPhone",
        "mobile",
        "contactMobile",
        "profileContactName",
        "contactName",
        "eventContacts",
        "personalSalutation",
        "profileUpdatedAt",
        "profileUpdatedBy",
        "updatedAt"
      ];
    }
    function editor() {
      return roleIs("editor") || admin();
    }
    function admin() {
      return roleIs("admin");
    }
    function publicPublished() {
      return (resource.data.status == "published" || resource.data.status == "aktiv")
        && (resource.data.visibility == "public" || resource.data.sichtbarkeit == "oeffentlich");
    }
    function publicMemberEventTeaser() {
      return resource.data.accessType == "members_only"
        && (
          resource.data.status == "active"
          || resource.data.status == "published"
          || resource.data.status == "aktiv"
        );
    }
    function registrationEvent() {
      return get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data;
    }
    function allowedRegistrationTarget() {
      return (
          registrationEvent().registrationEnabled == true
          || registrationEvent().preStatus == "invitation_published"
          || registrationEvent().lifecyclePhase == "registration_open"
        )
        && (
          (
            registrationEvent().accessType == "public"
            && (
              registrationEvent().registrationEnabled == true
              || registrationEvent().preStatus == "invitation_published"
              || registrationEvent().lifecyclePhase == "registration_open"
              || registrationEvent().allowPublicRegistration == true
              || !registrationEvent().keys().hasAny(["allowPublicRegistration"])
            )
          )
          || (member() && registrationEvent().accessType == "members_only" && registrationEvent().allowMemberRegistration == true)
        );
    }

    match /events/{eventId} {
      allow read: if publicPublished()
        || publicMemberEventTeaser()
        || (member() && resource.data.accessType == "members_only")
        || editor();
      allow create, update, delete: if editor();
    }

    match /eventLiveAccess/{eventId} {
      allow read, write: if admin();
    }

    match /eventLiveContactRequests/{requestId} {
      allow read, write: if false;
    }

    match /topics/{id} {
      allow read: if resource.data.status == "active" || editor();
      allow write: if editor();
    }

    match /editorialContent/{id} {
      allow read: if publicPublished()
        || (member() && (
          resource.data.visibility == "members"
          || resource.data.section == "member-area"
          || resource.data.page == "member-area"
        ))
        || editor();
      allow write: if editor();
    }

    match /members/{id} {
      allow read: if publicMemberRecord(resource.data)
        || editor()
        || ownMember(id);
      allow create, delete: if editor();
      allow update: if editor()
        || (
          ownMember(id)
          && request.resource.data.id == id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(memberProfileUpdateFields())
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["profileUpdatedBy"])
            || request.resource.data.profileUpdatedBy == request.auth.uid
            || request.resource.data.profileUpdatedBy == request.auth.token.email
          )
        );
    }

    match /contacts/{id} {
      allow read, write: if editor();
    }

    match /boardMembers/{id} {
      allow read: if resource.data.visibility == "public" && resource.data.status == "active" || editor();
      allow write: if editor();
    }

    match /speakers/{id} {
      allow read: if resource.data.status == "published" || editor();
      allow create, update: if editor();
      allow delete: if false;
    }

    match /sponsors/{id} {
      allow read: if resource.data.status == "published" || editor();
      allow write: if editor();
    }

    match /eventMedia/{id} {
      allow read: if resource.data.visibility == "public" && resource.data.status == "approved"
        || (member() && resource.data.visibility == "members" && resource.data.status == "approved")
        || editor();
      allow write: if editor();
    }

    match /media/{id} {
      allow read, write: if editor();
    }

    match /media_assets/{id} {
      allow read: if editor()
        || (resource.data.visibility == "public" && resource.data.status == "active");
      allow write: if editor();
    }

    match /media_variants/{id} {
      allow read, write: if editor();
    }

    match /media_videos/{id} {
      allow read, write: if editor();
    }

    match /downloads/{id} {
      allow read: if publicPublished()
        || (member() && resource.data.visibility == "members")
        || editor();
      allow write: if editor();
    }

    match /memberDocuments/{id} {
      allow read: if (member() && resource.data.visibility == "members" && resource.data.status == "published")
        || editor();
      allow write: if editor();
    }

    match /memberStrategyResponses/{id} {
      allow read, delete: if admin();
      allow create, update: if member()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.source == "zukunftsstrategie-2027-2030"
        && (request.resource.data.responseType == "survey" || request.resource.data.responseType == "idea")
        && request.resource.data.keys().hasOnly([
          "id",
          "source",
          "responseType",
          "userId",
          "memberId",
          "displayName",
          "email",
          "submittedAt",
          "answers",
          "idea",
          "updatedAt"
        ]);
    }
    match /memberDirectories/{id} {
      allow read: if (member() && resource.data.visibility == "members" && resource.data.status == "active")
        || editor();
      allow write: if editor();
    }

    match /galleries/{id} {
      allow read: if publicPublished()
        || (member() && resource.data.visibility == "members")
        || editor();
      allow write: if editor();
    }

    match /galleryImages/{id} {
      allow read: if resource.data.visibility == "public" && resource.data.status == "approved"
        || (member() && resource.data.visibility == "members" && resource.data.status == "approved")
        || editor();
      allow write: if editor();
    }

    match /registrations/{id} {
      // The client can initiate a public registration but cannot create tokens or set confirmation.
      allow create: if request.resource.data.status == "pending_email_confirmation"
        && request.resource.data.emailConfirmed == false
        && request.resource.data.privacyAccepted == true
        && allowedRegistrationTarget()
        && !request.resource.data.keys().hasAny(["confirmationTokenHash", "confirmedAt", "internalNote"]);
      allow read: if editor() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if editor();
    }

    match /event_feedback/{id} {
      allow read, update, delete: if editor();
      allow create: if editor();
    }
    match /checkinScreenEvents/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /membershipApplications/{id} {
      allow create: if request.resource.data.status == "new"
        && request.resource.data.source == "website"
        && request.resource.data.privacyAccepted == true
        && request.resource.data.statutesAccepted == true
        && request.resource.data.feeInfoAccepted == true
        && request.resource.data.company is string
        && request.resource.data.email is string
        && !request.resource.data.keys().hasAny(["internalNote", "reviewedAt", "reviewedBy"]);
      allow read, update, delete: if editor();
    }

    match /bounceReports/{id} {
      allow read: if admin();
      allow write: if false;
    }

    match /mailQueue/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /smsQueue/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /usageEvents/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /usageDaily/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /liveSurveys/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /liveSurveyResponses/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /liveSurveyInvites/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /speakerApprovals/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /speakerApprovalSubmissions/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /privacyConsents/{id} {
      allow read: if editor();
      allow write: if false;
    }

    match /aiLogs/{id} {
      allow read: if editor();
      allow create: if editor();
      allow update, delete: if false;
    }

    match /aiDrafts/{id} {
      allow read: if editor() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if editor();
      allow delete: if admin();
    }

    match /verified_sources/{id} {
      allow read, write: if editor();
    }

    match /article_sources/{id} {
      allow read, write: if editor();
    }

    match /article_keywords/{id} {
      allow read, write: if editor();
    }

    match /ai_prompts/{id} {
      allow read, write: if editor();
    }

    match /ai_image_generations/{id} {
      allow read: if editor();
      allow create: if editor();
      allow update, delete: if false;
    }

    match /ai_prompt_versions/{id} {
      allow read, write: if editor();
    }

    match /ai_prompt_tests/{id} {
      allow read, write: if editor();
    }

    match /ai_editorial_logs/{id} {
      allow read: if editor();
      allow create: if editor();
      allow update, delete: if false;
    }

    match /ai_topic_suggestions/{id} {
      allow read, write: if editor();
    }

    match /ai_topic_queue/{id} {
      allow read, write: if editor();
    }

    match /ai_topic_raw_data/{id} {
      allow read, write: if editor();
    }

    match /ai_press_releases/{id} {
      allow read, write: if editor();
    }

    match /ai_press_import_runs/{id} {
      allow read, write: if editor();
    }

    match /ai_press_source_status/{id} {
      allow read, write: if editor();
    }

    match /users/{userId} {
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow write: if admin();
    }

    match /accountingPaymentMatches/{id} {
      allow read: if admin();
      allow create: if admin() && accountingRecordOpen(request.resource.data) && accountingRecordOpen(get(/databases/$(database)/documents/accountingIncomingInvoices/$(request.resource.data.invoiceId)).data) && accountingRecordOpen(get(/databases/$(database)/documents/accountingStatements/$(request.resource.data.statementId)).data) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.invoiceId is string
        && request.resource.data.statementId is string
        && request.resource.data.rowIndex is int
        && request.resource.data.amountCents is int && request.resource.data.amountCents < 0;
      allow delete: if admin() && accountingRecordOpen(resource.data);
      allow update: if false;
    }

    match /accountingOutgoingPaymentMatches/{id} {
      allow read: if admin();
      allow create: if admin() && accountingRecordOpen(request.resource.data) && accountingRecordOpen(get(/databases/$(database)/documents/membershipContributions/$(request.resource.data.invoiceId)).data) && accountingRecordOpen(get(/databases/$(database)/documents/accountingStatements/$(request.resource.data.statementId)).data)
        && request.resource.data.invoiceId is string
        && request.resource.data.statementId is string
        && request.resource.data.rowIndex is int
        && request.resource.data.rowIndex >= 0
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.date is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /accountingIncomingInvoices/{id} {
      function validIncoming() {
        return request.resource.data.sourceHash == id
          && request.resource.data.currency == 'EUR'
          && request.resource.data.supplier is string
          && request.resource.data.invoiceNumber is string
          && request.resource.data.invoiceDate is string
          && ((request.resource.data.amountCents is int && request.resource.data.amountCents >= 0) || (request.resource.data.reviewStatus == 'needs_review' && request.resource.data.amountCents == null))
          && request.resource.data.iban is string
          && request.resource.data.paymentStatus in ['unrecorded','outstanding','paid','cancelled']
          && (request.resource.data.paymentStatus != 'paid' || request.resource.data.paidDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && request.resource.data.reviewStatus in ['needs_review','reviewed']
          && (request.resource.data.reviewStatus != 'reviewed' || (request.resource.data.supplier.size() > 0 && request.resource.data.invoiceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.amountCents is int))
          && request.resource.data.updatedBy == request.auth.uid;
      }
      allow read: if admin();
      allow create: if admin() && accountingRecordOpen(request.resource.data) && validIncoming() && request.resource.data.createdBy == request.auth.uid && request.resource.data.originalImport is map;
      allow update: if admin() && accountingRecordOpen(resource.data) && accountingRecordOpen(request.resource.data) && validIncoming()
        && request.resource.data.extractedText == resource.data.extractedText
        && request.resource.data.sourceName == resource.data.sourceName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.originalImport == resource.data.originalImport;
      allow delete: if false;
    }

    match /accountingStatements/{id} {
      allow read: if admin();
      allow create: if admin() && accountingRecordOpen(request.resource.data)
        && request.resource.data.sourceHash == id
        && request.resource.data.currency == 'EUR'
        && request.resource.data.openingCents is int
        && request.resource.data.closingCents is int
        && request.resource.data.rows is list
        && request.resource.data.rows.size() <= 1000
        && request.resource.data.warnings is list
        && request.resource.data.warnings.size() == 0
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if admin() && accountingRecordOpen(resource.data) && accountingRecordOpen(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['excludedAssignmentRows','updatedAt','updatedBy'])
        && request.resource.data.excludedAssignmentRows is list
        && request.resource.data.excludedAssignmentRows.size() <= resource.data.rows.size()
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /accountingFolders/{category} {
      allow read: if admin();
      allow create, update: if admin()
        && category in ['outgoing', 'incoming', 'statements']
        && request.resource.data.keys().hasOnly(['category', 'folderName', 'path', 'assignmentId', 'updatedAt', 'updatedBy'])
        && request.resource.data.category == category
        && request.resource.data.folderName is string
        && request.resource.data.folderName.size() > 0
        && request.resource.data.folderName.size() <= 255
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() <= 2000
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() == 36
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /membershipContributions/{id} {
      allow read: if admin();
      allow create: if admin() && accountingRecordOpen(request.resource.data)
        && request.resource.data.invoiceNumber is string
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 0
        && request.resource.data.currency == "EUR";
      allow update: if admin() && accountingRecordOpen(resource.data) && accountingRecordOpen(request.resource.data)
        && request.resource.data.invoiceNumber == resource.data.invoiceNumber
        && request.resource.data.originalImport == resource.data.originalImport
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 0
        && request.resource.data.currency == "EUR";
      allow delete: if false;
    }

    match /settings/{id} {
      allow read: if editor() || id == "browserPush";
      allow create, update: if (admin() || (editor() && (id == "eventTypes" || id == "browserPush")))
        && (id != 'accountingBookingAccounts' || accountingAssignmentOpen())
        && (!id.matches('accountingOverview-[0-9]{4}') || accountingYearOpen(id.split('-')[1]));
      allow delete: if admin() && id != 'accountingBookingAccounts'
        && (!id.matches('accountingOverview-[0-9]{4}') || accountingYearOpen(id.split('-')[1]));
    }

    match /system/{id} {
      allow read, write: if admin();
    }

    match /auditLog/{id} {
      allow read: if admin();
      allow create: if editor();
      allow update, delete: if false;
    }
  }
}
