rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function user() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function userProfileExists() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function roleMatches(storedRole, role) {
      return storedRole == role
        || (role == "admin" && (storedRole == "Admin" || storedRole == "administrator" || storedRole == "owner"))
        || (role == "editor" && (storedRole == "Editor" || storedRole == "redakteur" || storedRole == "redaktion"))
        || (role == "member" && (storedRole == "Mitglied" || storedRole == "mitglied"));
    }
    function editor() {
      return signedIn() && (
        (
          userProfileExists()
          && (roleMatches(user().role, "admin") || roleMatches(user().role, "editor"))
          && user().status != "inactive"
        )
        || roleMatches(request.auth.token.role, "admin")
        || roleMatches(request.auth.token.role, "editor")
      );
    }
    function member() {
      return signedIn() && (
        (
          userProfileExists()
          && (roleMatches(user().role, "member") || roleMatches(user().role, "admin") || roleMatches(user().role, "editor"))
          && user().status != "inactive"
        )
        || roleMatches(request.auth.token.role, "member")
        || roleMatches(request.auth.token.role, "admin")
        || roleMatches(request.auth.token.role, "editor")
      );
    }

    match /events/{eventId}/{mediaId}/{fileName} {
      allow write: if editor() && request.resource.size < 30 * 1024 * 1024;
      allow read: if editor()
        || (
          firestore.get(/databases/(default)/documents/eventMedia/$(mediaId)).data.eventId == eventId
          && firestore.get(/databases/(default)/documents/eventMedia/$(mediaId)).data.status == "approved"
          && (
            firestore.get(/databases/(default)/documents/eventMedia/$(mediaId)).data.visibility == "public"
            || (member() && firestore.get(/databases/(default)/documents/eventMedia/$(mediaId)).data.visibility == "members")
          )
        );
    }

    match /members/{memberId}/{fileName} {
      allow read: if true;
      allow write: if editor() && request.resource.size < 10 * 1024 * 1024;
    }

    match /board/{boardMemberId}/{fileName} {
      allow read: if true;
      allow write: if editor() && request.resource.size < 10 * 1024 * 1024;
    }

    match /topics/{topicId}/{fileName} {
      allow read: if true;
      allow write: if editor() && request.resource.size < 20 * 1024 * 1024;
    }

    match /editorial/{contentId}/{fileName} {
      allow read: if true;
      allow write: if editor() && request.resource.size < 20 * 1024 * 1024;
    }

    match /galleries/{galleryId}/{fileName} {
      allow read: if true;
      allow write: if editor() && request.resource.size < 15 * 1024 * 1024;
    }

    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if editor() && request.resource.size < 30 * 1024 * 1024;
    }

    match /speakers/{speakerId}/{fileName} {
      allow read: if editor()
        || firestore.get(/databases/(default)/documents/speakers/$(speakerId)).data.status == "published";
      allow write: if editor() && request.resource.size < 10 * 1024 * 1024;
    }

    match /sponsors/{sponsorId}/{fileName} {
      allow read: if editor()
        || firestore.get(/databases/(default)/documents/sponsors/$(sponsorId)).data.status == "published";
      allow write: if editor() && request.resource.size < 10 * 1024 * 1024;
    }

    match /member-documents/{documentId}/{fileName} {
      allow read: if editor()
        || (
          member()
          && firestore.get(/databases/(default)/documents/memberDocuments/$(documentId)).data.status == "published"
        );
      allow write: if editor() && request.resource.size < 30 * 1024 * 1024;
    }

    match /member-directories/{directoryId}/{fileName} {
      allow read: if editor()
        || (
          member()
          && firestore.get(/databases/(default)/documents/memberDirectories/$(directoryId)).data.status == "published"
        );
      allow write: if editor() && request.resource.size < 30 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
